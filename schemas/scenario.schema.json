{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://joyner-usal.github.io/read-and-rip/schemas/scenario.schema.json",
  "title": "Read and Rip scenario",
  "description": "One rep: a cue to read and the zones that answer it. Zones are named from the shooter's view.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "game", "mode", "approachAngleDeg", "shooterHand", "cueType",
    "fake", "readWindowMs", "bestZone", "goodZones", "difficulty", "rulesNote", "status"
  ],
  "definitions": {
    "zone": {
      "type": "string",
      "enum": [
        "top-left", "top-center", "top-right",
        "mid-left", "mid-center", "mid-right",
        "low-left", "low-center", "low-right"
      ]
    }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^(boys|girls)-(shooter|goalie)-[a-z0-9-]+$",
      "description": "Unique. Starts with game and mode, for example boys-shooter-wing-high-001."
    },
    "game": { "enum": ["boys", "girls"] },
    "mode": { "enum": ["shooter", "goalie"] },
    "approachAngleDeg": {
      "type": "number", "minimum": -75, "maximum": 75,
      "description": "Degrees from straight on. 0 is top center. Negative is the shooter's left side of the field."
    },
    "shooterHand": { "enum": ["right", "left"] },
    "cueType": {
      "enum": [
        "goalie-off-angle", "goalie-stick-high", "goalie-stick-low", "goalie-weight-shift",
        "goalie-low-stance", "goalie-early-drop",
        "hands-high", "hands-low", "hip-turn", "shoulder-dip",
        "release-sidearm", "release-overhand", "release-underhand", "stick-fake", "head-fake"
      ]
    },
    "fake": { "type": "boolean" },
    "readWindowMs": { "type": "integer", "minimum": 400, "maximum": 4000 },
    "releaseMs": {
      "type": "integer", "minimum": 100,
      "description": "Fakes only. Ms into the read window when the real shot is released."
    },
    "bestZone": { "$ref": "#/definitions/zone" },
    "goodZones": {
      "type": "array", "items": { "$ref": "#/definitions/zone" }, "maxItems": 4, "uniqueItems": true
    },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "rulesNote": { "type": "string", "minLength": 10, "maxLength": 280 },
    "status": { "enum": ["draft", "approved"] }
  }
}
